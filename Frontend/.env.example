# Google Maps JavaScript API Key
# Get your API key from https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Vite proxies API and Socket.IO requests to this backend during development.
VITE_API_PROXY_TARGET=http://localhost:3000
# Optional direct URLs when bypassing the Vite proxy.
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000
# Local demo only. VITE_ values are bundled into browser code; never put a production admin secret here.
# VITE_ADMIN_API_KEY=
