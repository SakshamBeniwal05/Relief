PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
AI_ENGINE_URL=http://127.0.0.1:3100
# Without DATABASE_URL the API uses seeded, process-local demo data.
DATABASE_URL=postgres://postgres:password@localhost:5432/relief
DATABASE_SSL=false
# Required for admin routes before exposing the server beyond local development.
ADMIN_API_KEY=replace-with-a-long-random-secret
